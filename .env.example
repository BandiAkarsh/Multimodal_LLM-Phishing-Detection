# Phishing Detection Project - Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ==========================================
# Security Settings (REQUIRED)
# ==========================================

# JWT Secret for API authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here-minimum-32-characters-long

# JWT Token Expiration (hours)
JWT_EXPIRATION_HOURS=24

# ==========================================
# Server Configuration
# ==========================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Environment (development/production)
ENVIRONMENT=development

# Enable HTTPS (requires SSL certificates)
ENABLE_HTTPS=false

# SSL Certificate paths (only used if ENABLE_HTTPS=true)
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key

# ==========================================
# API Configuration
# ==========================================

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==========================================
# Redis Configuration (Optional - for production)
# ==========================================

# Redis URL for distributed rate limiting and caching
# Format: redis://[:password@]host[:port][/db]
# Leave empty to use in-memory rate limiting (not suitable for multi-worker deployments)
REDIS_URL=

# ==========================================
# MLLM Configuration (Optional)
# ==========================================

# Enable Multi-Modal Language Model for Tier 3 analysis
# Set to true to enable AI-powered content analysis (requires more resources)
LOAD_MLLM=false

# Ollama API URL for MLLM inference
OLLAMA_URL=http://localhost:11434

# MLLM Model name
MLLM_MODEL=qwen2.5-vl-7b-instruct

# ==========================================
# Feature Configuration
# ==========================================

# Enable web scraping for dynamic content analysis
ENABLE_SCRAPING=true

# Enable TLS/SSL certificate analysis
ENABLE_TLS_ANALYSIS=true

# ==========================================
# Logging Configuration
# ==========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./08_logs/api.log

# ==========================================
# Browser Extension Configuration
# ==========================================

# API URL for browser extension (used by popup.js)
EXTENSION_API_URL=http://localhost:8000

# ==========================================
# Development Settings
# ==========================================

# Enable auto-reload on code changes (development only)
RELOAD=true

# Enable debug mode (shows detailed error messages)
DEBUG=false

# ==========================================
# Docker Configuration
# ==========================================

# Docker image tag
DOCKER_IMAGE_TAG=latest

# Docker registry
DOCKER_REGISTRY=ghcr.io

# ==========================================
# MLflow Configuration
# ==========================================

# MLflow tracking URI
MLFLOW_TRACKING_URI=./08_logs/mlruns

# MLflow experiment name
MLFLOW_EXPERIMENT_NAME=phishing_detection

# ==========================================
# Email Scanner Configuration
# ==========================================

# Email provider settings (if implementing email scanning)
EMAIL_IMAP_SERVER=
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_SSL=true

# ==========================================
# External API Keys (Optional)
# ==========================================

# VirusTotal API key for reputation checking
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API key
GOOGLE_SAFE_BROWSING_API_KEY=
